# Front for Railway: one public port ($PORT) for the Next.js app and the WebSocket server
# (browsers connect to wss://YOUR-DOMAIN/_ws), like upstream's Caddyfile minus TLS, which
# Railway's edge terminates.
{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
	log {
		level ERROR
	}
}

:{$PORT} {
	request_body {
		max_size 80MB
	}

	@ws path /_ws*
	reverse_proxy @ws 127.0.0.1:8080 {
		header_up X-Forwarded-For {header.X-Forwarded-For}
	}

	reverse_proxy 127.0.0.1:3001 {
		header_up X-Forwarded-For {header.X-Forwarded-For}
	}
}
